{
  "annotations": {"list": []}, "editable": false,
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Last Spark progress age by query", "description": "Driver progress callbacks, not end-to-end delivery. Idle streams may have no new batch. Missing is unknown.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "time() - pulseforge_stream_last_progress_timestamp_seconds", "legendFormat": "{{query}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "No progress observed"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "Spark input rows in completed attempts (5m rate)", "description": "May count a replayed batch again; use warehouse rows for durable counts.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "sum by (query) (rate(pulseforge_stream_input_rows_total[5m]))", "legendFormat": "{{query}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "rows/s", "noValue": "No completed attempts"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Spark batch p95 duration (5m)", "description": "Trigger duration in seconds by query.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le,query) (rate(pulseforge_stream_batch_duration_seconds_bucket[5m])))", "legendFormat": "{{query}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "No completed attempts"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "type": "timeseries", "title": "Validation rejection attempts by category (5m)", "description": "Diagnostic query; replay may repeat attempts. DLQ records retain evidence.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "sum by (reason) (increase(pulseforge_stream_validation_rejection_attempts_total[5m]))", "legendFormat": "{{reason}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No rejection attempts"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Watermark drops and sink failures (5m)", "description": "Watermark drops are Spark attempts; sink failures are callback attempts.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "sum(increase(pulseforge_stream_watermark_drops_total[5m]))", "legendFormat": "watermark drops", "refId": "A"}, {"expr": "sum by (dependency) (increase(pulseforge_stream_sink_failures_total[5m]))", "legendFormat": "sink {{dependency}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No attempts"}}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}},
    {"id": 6, "type": "timeseries", "title": "Durable warehouse rows and batches", "description": "PostgreSQL ledger and unique event rows; replay-safe committed state.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "pulseforge_warehouse_committed_rows", "legendFormat": "unique rows", "refId": "A"}, {"expr": "pulseforge_warehouse_committed_batches", "legendFormat": "committed batches", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "Warehouse unavailable"}}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}},
    {"id": 7, "type": "timeseries", "title": "Raw Spark processed Kafka offsets", "description": "Spark-reported end offsets per fixed partition; not committed consumer-group lag.", "datasource": {"uid": "pulseforge-prometheus"}, "targets": [{"expr": "pulseforge_stream_source_offset", "legendFormat": "partition {{partition}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "No offset reported"}}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}}
  ],
  "schemaVersion": 41, "tags": ["pulseforge", "operations"], "templating": {"list": []},
