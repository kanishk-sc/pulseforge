# Run `uv run python scripts/init_env.py` to generate local random credentials.
# These values deliberately cannot start the stack until replaced.
POSTGRES_USER=pulseforge
POSTGRES_DB=pulseforge
POSTGRES_PASSWORD=
MINIO_ROOT_USER=pulseforge
MINIO_ROOT_PASSWORD=
EVENTS_PER_SECOND=10
ANOMALY_RATE=0.02
GENERATOR_SEED=42
SPARK_WATERMARK_DELAY=10 minutes
SPARK_TRIGGER_INTERVAL=10 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
SPARK_SHUFFLE_PARTITIONS=4
LAKE_RETENTION_DAYS=30
LAKE_RETENTION_DRY_RUN=true
